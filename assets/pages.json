---
---
[
{%- assign first = true -%}
{%- for p in site.pages -%}
  {%- assign ext = p.path | split: "." | last -%}
  {%- if ext == "md" -%}
    {%- unless first -%},{%- endunless -%}
    {"url": {{ p.url | relative_url | jsonify }}, "path": {{ p.path | jsonify }}, "title": {{ p.title | default: p.path | jsonify }}}
    {%- assign first = false -%}
  {%- endif -%}
{%- endfor -%}
]
